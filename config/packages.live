# Strictly minimal KryX Linux Live ISO package list (no bloat)
# Every name below matches an exact port in kryx-linux/{core,opt,ports}.
# Installed via `kpm --root=<rootfs> install --deps`

# Essential userland, shared runtime libs & init (core)
filesystem
glibc
zlib
bzip2
xz
zstd
attr
acl
libcap
libcap-ng
libxcrypt
libpcre2
libgmp
libmpfr
libmd
libbsd
linux-pam
expat
db
elfutils
libtirpc
sqlite3
file
libdevmapper
ncurses
readline
dash
bash
coreutils
eudev
util-linux
sysvinit
grep
sed
gawk
tar
gzip
kmod
procps
shadow
less

# Disk & filesystem tools (core + opt)
e2fsprogs
dosfstools

# Networking & TLS (core + opt)
libmnl
libnghttp2
openssl
ca-certificates
curl
iproute2
dhcpcd
libnl
dbus
wireless-tools
wpa_supplicant

# Bootloader tools for target install (opt)
libpng
freetype
efivar
efibootmgr
grub2
grub2-efi

# KryX tools & crypto verification (core + rolling; kpm provides integrated ports/pkgutils)
signify
kpm
