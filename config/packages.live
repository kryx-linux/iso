# Strictly minimal KryX Linux Live ISO package list (no bloat)
# Every name below matches an exact port in kryx-linux/{core,opt,ports}.
# Installed via `kpm --root=<rootfs> install --deps`

# Essential userland, shared runtime libs & init (core)
filesystem
glibc
zlib
bzip2
xz
zstd
attr
acl
libcap
libcap-ng
libxcrypt
libpcre2
libgmp
libmpfr
libmd
libbsd
libtirpc
libnsl
linux-pam
dumb_runtime_dir
expat
db
elfutils
sqlite3
file
libdevmapper
ncurses
readline
dash
bash
coreutils
eudev
util-linux
sysvinit
rc
start-stop-daemon
grep
sed
gawk
findutils
tar
gzip
kmod
procps
shadow
sudo
less
vim

# Disk & filesystem tools (core + opt)
e2fsprogs
dosfstools

# Networking, Wi-Fi & Hardware Firmware (core + opt — laptop-ready, no Ethernet required)
libmnl
libnghttp2
openssl
ca-certificates
curl
inetutils
iproute2
iputils
dhcpcd
libnl
dbus
wireless-tools
wpa_supplicant
iwd
linux-firmware

# Interactive TUI installer dependency (opt)
dialog

# Bootloader tools for target install (opt)
libpng
freetype
efivar
efibootmgr
grub2
grub2-efi

# KryX tools & crypto verification (core + rolling; kpm provides integrated ports/pkgutils)
signify
kpm
