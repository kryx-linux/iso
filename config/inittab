# /etc/inittab - KryX Linux Live System runlevel configuration

id:2:initdefault:

rc::sysinit:/etc/rc
rs:S1:wait:/etc/rc.single
l0:0:wait:/etc/rc.shutdown halt
l6:6:wait:/etc/rc.shutdown reboot
su:S:wait:/sbin/sulogin -p

# Drop cleanly into a root TTY on tty1 and standard login TTYs on tty2-tty6
c1:2:respawn:/sbin/agetty --autologin root --noclear 38400 tty1 linux
c2:2:respawn:/sbin/agetty 38400 tty2 linux
c3:2:respawn:/sbin/agetty 38400 tty3 linux
c4:2:respawn:/sbin/agetty 38400 tty4 linux
c5:2:respawn:/sbin/agetty 38400 tty5 linux
c6:2:respawn:/sbin/agetty 38400 tty6 linux

# Serial console support (active only when console=ttyS0 is on /proc/cmdline)
s0:2:respawn:/sbin/serial-getty

ca::ctrlaltdel:/sbin/shutdown -t3 -r now
