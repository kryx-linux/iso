# KryX Linux live ISO Kconfig fragment applied on top of our adapted kernel config
# (kernel/linux-6.18.63.config) for KryX identity + live SquashFS/OverlayFS boot.
CONFIG_LOCALVERSION="-kryx"
CONFIG_DEFAULT_HOSTNAME="kryx"
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_EFI_STUB=y
